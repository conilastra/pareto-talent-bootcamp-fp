  ] },
  { key: "timing", title: "When do you want help?", opts: [
    { label: "Within a month", value: "within_month" }, { label: "In 1 to 3 months", value: "one_to_three" }, { label: "Later, just looking", value: "later" },
  ] },
];

type Scene = Partial<Record<QKey, string>>;

export function qualify(q: Scene): { qualified: boolean; reasons: string[] } {
  const reasons: string[] = [];
  if (q.role !== "founder_ceo_owner") reasons.push("role");
  if (!["500k_1m", "1m_5m", "5m_plus"].includes(q.revenue || "")) reasons.push("revenue");
  if (q.team === "solo") reasons.push("team");
  if (!["within_month", "one_to_three"].includes(q.timing || "")) reasons.push("timing");
  return { qualified: reasons.length === 0, reasons };
}

export function pickType(loops: string[], root: string): string {
  if (root) return root;
  return loops.includes("head") || loops.includes("team") ? "outgrown" : "do_it_all";
}

const tabWord = (n: number) => (n === 1 ? "tab" : "tabs");
