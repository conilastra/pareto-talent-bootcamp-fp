const smallWords = (n: number) => (n === 1 ? "one tab" : n === 2 ? "two tabs" : "three tabs");

export function tabStatus(n: number): string {
  return n === 0 ? "Running smoothly" : n <= 3 ? "Running fine" : n <= 7 ? "Getting slower" : "Not responding";
}
export function memoryPct(n: number): number {
  return n === 0 ? 8 : Math.min(96, 14 + n * 8);
}

