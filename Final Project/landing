const HERO_IDS = LOOPS.slice(0, 9).map((l) => l.id);

function HeroDemo() {
  const [n, setN] = useState(0);
  useEffect(() => {
    const reduce = typeof window.matchMedia === "function" && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) {
      setN(6);
      return;
    }
    let c = 0;
    let dir = 1;
    let timer: number | undefined;
    const tick = () => {
      let delay: number;
      if (dir === 1) {
        c += 1;
        setN(c);
        if (c >= HERO_IDS.length) {
          dir = -1;
          delay = 1500;
        } else delay = 420;
      } else {
        c -= 1;
        setN(c);
        if (c <= 0) {
          dir = 1;
          delay = 1600;
        } else delay = 260;
      }
      timer = window.setTimeout(tick, delay);
    };
    timer = window.setTimeout(tick, 700);
    return () => {
      if (timer !== undefined) window.clearTimeout(timer);
    };
  }, []);
  return (
    <div aria-hidden="true">
      <TabFrame ids={HERO_IDS} shown={n} />
    </div>
  );
}

export default function OpenTabs() {
  const [step, setStep] = useState(0);
  const [loops, setLoops] = useState<string[]>([]);
  const [root, setRoot] = useState("");
  const [scene, setScene] = useState<Scene>({});
  const [showMissing, setShowMissing] = useState(false);
  const [loopErr, setLoopErr] = useState("");
  const [first, setFirst] = useState("");
  const [last, setLast] = useState("");
  const [email, setEmail] = useState("");
  const [consent, setConsent] = useState(false);
  const [errs, setErrs] = useState<Record<string, string>>({});
  const [status, setStatus] = useState<"idle" | "sending" | "sent" | "failed" | "demo">("idle");
  const [approved, setApproved] = useState<string[]>([]);
  const [closing, setClosing] = useState<number | null>(null);
  const [showBar, setShowBar] = useState(false);
  const heroBtn = useRef<HTMLButtonElement>(null);

  const params = useMemo(() => {
    try {
      return new URLSearchParams(window.location.search);
    } catch (e) {
      return new URLSearchParams();
    }
  }, []);
  const ref = params.get("ref") || "";
  const view = params.get("view") || "";

  useEffect(() => {
    document.title = view === "booked" ? "You're booked | Pareto Talent" : view === "thanks" ? "Thank you | Pareto Talent" : "How many tabs does your brain have open? | Pareto Talent";
  }, []);
  useEffect(() => {
    window.scrollTo(0, 0);
  }, [step]);

  useEffect(() => {
    const el = heroBtn.current;
    if (step !== 0 || !el || typeof IntersectionObserver === "undefined") {
      setShowBar(false);
      return;
    }
    const io = new IntersectionObserver(([entry]) => setShowBar(!entry.isIntersecting));
    io.observe(el);
    return () => io.disconnect();
  }, [step]);

  useEffect(() => {
    if (step !== 4) {
      setClosing(null);
      return;
    }
    const n = loops.length;
    const reduce = typeof window.matchMedia === "function" && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) {
      setClosing(0);
      return;
    }
    setClosing(n);
    let c = n;
    let iv: number | undefined;
    const t = window.setTimeout(() => {
      iv = window.setInterval(() => {
        c -= 1;
        setClosing(c);
        if (c <= 0 && iv !== undefined) window.clearInterval(iv);
      }, 320);
    }, 900);
    return () => {
      window.clearTimeout(t);
      if (iv !== undefined) window.clearInterval(iv);
    };
  }, [step]); // eslint-disable-line react-hooks/exhaustive-deps

  const toggleLoop = (id: string) => {
    setLoopErr("");
    setLoops((p) => (p.includes(id) ? p.filter((x) => x !== id) : [...p, id]));
  };
  const toggleApproved = (id: string) => setApproved((p) => (p.includes(id) ? p.filter((x) => x !== id) : [...p, id]));

  const q = qualify(scene);
  const type = pickType(loops, root);
  const shownLoops = loops.slice(0, 3).map((id) => LOOP_BY_ID[id]);
  const n3 = shownLoops.length;
  const more = loops.length - n3;
  const shownTabs = step === 4 && closing !== null ? closing : loops.length;

  const buildPayload = () => {
    const n = loops.length;
    const intro =
      n === 1
        ? "You had 1 tab open in your head:"
        : n <= 3
        ? "You had " + n + " tabs open in your head:"
        : "You had " + n + " tabs open in your head. The first three:";
    const source = ref ? "referral" : "direct";
    return {
      first_name: first.trim(), last_name: last.trim(), email: email.trim(), consent: true,
      country: scene.country || "", role: scene.role || "", team_size: scene.team || "", revenue_band: scene.revenue || "", timeline: scene.timing || "",
      qualified: q.qualified ? "yes" : "no", qualified_reasons: q.reasons.join(","),
      result_type: type, result_label: TYPES[type].label, stuck_tab: root,
      tabs_open: n, tabs_open_text: n + " " + tabWord(n), tabs_all: loops.map((id) => LOOP_BY_ID[id].chip).join(" | "),
      email_intro: intro,
      tabs_list_html: "<ul>" + shownLoops.map((l) => "<li>" + esc(l.chip) + "</li>").join("") + "</ul>",
      plan_list_html: shownLoops.map((l) => "<p>&#9744; <b>" + esc(l.tab) + ":</b> " + esc(l.brief) + "</p>").join(""),
      pattern_line: TYPES[type].pattern,
      close_yourself_heading: smallThings(n3),
      close_list_html: "<ol>" + shownLoops.map((l) => "<li>" + esc(l.close) + "</li>").join("") + "</ol>",
      source, ref,
      utm_source: params.get("utm_source") || "", utm_medium: params.get("utm_medium") || "", utm_campaign: params.get("utm_campaign") || "",
    };
  };

  const send = async () => {
    if (WEBHOOK_URL.includes("REPLACE_WITH")) {
      setStatus("demo");
      return;
    }
    setStatus("sending");
    try {
      const p = buildPayload();
      const mode: string = SEND_MODE;
      if (mode === "json") {
        const res = await fetch(WEBHOOK_URL, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(p) });
        if (!res.ok) throw new Error("bad status");
      } else if (mode === "text") {
        await fetch(WEBHOOK_URL, { method: "POST", mode: "no-cors", headers: { "Content-Type": "text/plain" }, body: JSON.stringify(p) });
      } else {
        const body = new URLSearchParams();
        Object.entries(p).forEach(([k, v]) => body.append(k, String(v)));
        await fetch(WEBHOOK_URL, { method: "POST", mode: "no-cors", body });
      }
      setStatus("sent");
    } catch (e) {
      setStatus("failed");
    }
  };

  const toScene = () => {
    if (loops.length === 0) {
      setLoopErr("Tap at least one tab first.");
      return;
    }
    setStep(2);
  };
  const toGate = () => {
    if (QUESTIONS.some((x) => !scene[x.key])) {
      setShowMissing(true);
      return;
    }
    setStep(3);
  };
  const submitEmail = () => {
    const e: Record<string, string> = {};
    if (!first.trim()) e.first = "Enter your first name.";
    if (!last.trim()) e.last = "Enter your last name.";
    if (!/^\S+@\S+\.\S+$/.test(email.trim())) e.email = "Enter a valid email address.";
    if (!consent) e.consent = "Tick the box to continue.";
    setErrs(e);
    if (Object.keys(e).length) return;
    setStep(4);
    if (!q.qualified) {
      try {
        window.history.replaceState(null, "", "?view=thanks");
      } catch (err) {
        /* ignore */
      }
    }
    void send();
  };
  const restart = () => {
    setStep(0);
    setLoops([]);
    setRoot("");
    setScene({});
    setShowMissing(false);
    setApproved([]);
    setStatus("idle");
    setErrs({});
  };

  const progress = step === 0 ? 0 : Math.min(step, 4) * 25;
  const n = loops.length;

  const statusEl = (
    <>
      {status === "sent" && <p className="pt-ok">A copy is on its way to {email.trim()}.</p>}
      {status === "sending" && <p className="pt-ok">Sending a copy to {email.trim()}...</p>}
      {status === "demo" && <p className="pt-ok">Demo mode: the webhook address is not set, so nothing was sent.</p>}
      {status === "failed" && (
        <p className="pt-err">We couldn't send the email copy. Check your address and try again. <button className="pt-btn pt-ghost pt-small-btn" style={{ marginLeft: 8 }} onClick={() => void send()}>Try again</button></p>
      )}
    </>
  );

  if (view === "booked") return <BookedPage />;
  if (view === "thanks") return <ThanksPage />;

  return (
    <div className="pt-root" style={step === 0 ? { paddingBottom: 110 } : undefined}>
      <style>{CSS}</style>
      <div className={"pt-wrap" + (step === 0 ? " pt-wide" : "")}>
        <img className="pt-logo" src={LOGO} alt="Pareto Talent" />

        {step >= 1 && step <= 3 && (
          <div className="pt-progress" aria-hidden="true">
            <div style={{ width: progress + "%" }} />
          </div>
        )}

        {step === 0 && (
          <>
          <div className="pt-hero">
            <div>
              <h1 className="pt-h1">
                How many <span className="pt-gr">tabs</span> does your brain have open?
              </h1>
              <p className="pt-lede">Every unanswered email, forgotten follow-up and pending decision is a tab, and too many of them slow you down. Take the free check, get a one-page checklist to close the first ones, and see how a trained Right Hand, your own assistant who stays one step ahead of you, would handle the rest.</p>
              <button className="pt-btn" ref={heroBtn} onClick={() => setStep(1)}>{START_LABEL}</button>
              <p className="pt-hint" style={{ marginTop: 16 }}>Free. About a minute. No typing.</p>
            </div>
            {HERO_IMAGE ? <img className="pt-heroimg" src={HERO_IMAGE} alt={HERO_IMAGE_ALT} fetchPriority="high" /> : <HeroDemo />}
          </div>
          <Landing />
          </>
        )}

        {step === 1 && (
          <div className="pt-card">
            <p className="pt-eyebrow">Step 1 of 3</p>
            <TabFrame ids={loops} shown={n} sticky />
            <h2 className="pt-h2">Tap what's open in your head.</h2>
            <p className="pt-hint">Tap as many as ring true. Each one opens a tab.</p>
            <div className="pt-chips" role="group" aria-label="Tabs open in your head">
              {LOOPS.map((l) => (
                <button key={l.id} className="pt-chip" aria-pressed={loops.includes(l.id)} onClick={() => toggleLoop(l.id)}>
                  <span className="pt-dot"><Check /></span>
                  <span>{l.chip}</span>
                </button>
              ))}
            </div>
            <p className="pt-label">And the one tab you can't seem to close <small>(pick one)</small></p>
            <div className="pt-chips" role="group" aria-label="The tab you can't seem to close">
              {ROOTS.map((r) => (
                <button key={r.value} className="pt-chip" aria-pressed={root === r.value} onClick={() => setRoot(root === r.value ? "" : r.value)}>
                  {r.label}
                </button>
              ))}
            </div>
            <div className="pt-bar">
              <span className="pt-count">{n} of {LOOPS.length} tabs open</span>
              <button className="pt-btn" onClick={toScene}>Show me my cleanup plan</button>
            </div>
            {loopErr && <p className="pt-err" role="alert">{loopErr}</p>}
            <button className="pt-back" onClick={() => setStep(0)}>Back</button>
          </div>
        )}

        {step === 2 && (
          <div className="pt-card">
            <p className="pt-eyebrow">Step 2 of 3</p>
            <h2 className="pt-h2">{n} {n === 1 ? "tab is" : "tabs are"} open. Now set the scene.</h2>
            <p className="pt-hint">Five taps so your Tab Cleanup Plan fits your business.</p>
            {QUESTIONS.map((qq) => (
              <div key={qq.key}>
                <p className="pt-label">{qq.title}</p>
                <div className="pt-chips" role="group" aria-label={qq.title}>
                  {qq.opts.map((o) => (
                    <button key={o.value} className="pt-chip" aria-pressed={scene[qq.key] === o.value} onClick={() => setScene((p) => ({ ...p, [qq.key]: o.value }))}>
                      {o.label}
                    </button>
                  ))}
                </div>
                {showMissing && !scene[qq.key] && <p className="pt-err" role="alert">Pick one to continue.</p>}
              </div>
            ))}
            <div className="pt-bar">
              <button className="pt-back" style={{ margin: 0 }} onClick={() => setStep(1)}>Back</button>
              <button className="pt-btn" onClick={toGate}>Continue</button>
            </div>
          </div>
        )}

        {step === 3 && (
          <div className="pt-card">
            <p className="pt-eyebrow">Step 3 of 3</p>
            <div className="pt-lock">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#50D3A1" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
              <span>Your Tab Cleanup Plan is ready: a plan for {n === 1 ? "your tab" : "each of your " + n + " tabs"}, plus {smallWords(n3)} you can close yourself today.</span>
            </div>
            <h2 className="pt-h2">Where should we send it?</h2>
            <p className="pt-hint">You'll see it on screen right away, and get a copy by email.</p>
            <div className="pt-field"><label htmlFor="f1">First name</label><input id="f1" className="pt-input" autoComplete="given-name" value={first} onChange={(e) => setFirst(e.target.value)} />{errs.first && <p className="pt-err" role="alert">{errs.first}</p>}</div>
            <div className="pt-field"><label htmlFor="f1b">Last name</label><input id="f1b" className="pt-input" autoComplete="family-name" value={last} onChange={(e) => setLast(e.target.value)} />{errs.last && <p className="pt-err" role="alert">{errs.last}</p>}</div>
            <div className="pt-field"><label htmlFor="f2">Email</label><input id="f2" type="email" className="pt-input" autoComplete="email" value={email} onChange={(e) => setEmail(e.target.value)} />{errs.email && <p className="pt-err" role="alert">{errs.email}</p>}</div>
            <label className="pt-check"><input type="checkbox" checked={consent} onChange={(e) => setConsent(e.target.checked)} /><span>I agree to receive emails from Pareto Talent. <a href={TERMS_URL} target="_blank" rel="noopener noreferrer" style={{ color: "#50D3A1" }}>Terms and privacy</a></span></label>
            {errs.consent && <p className="pt-err" role="alert">{errs.consent}</p>}
            <button className="pt-btn" onClick={submitEmail}>Send me my plan</button>
            <br />
            <button className="pt-back" onClick={() => setStep(2)}>Back</button>
          </div>
        )}

        {step === 4 && (
          <div>
            <p className="pt-eyebrow">{q.qualified ? first.trim() + "'s Tab Cleanup Plan" : "Thank you, " + first.trim()}</p>
            <h1 className="pt-h1">Your brain had {n} {tabWord(n)} open. Here is how a Right Hand would <span className="pt-gr">handle them</span>.</h1>
            {!q.qualified && statusEl}
            <TabFrame ids={loops} shown={shownTabs} done />
            <p className="pt-lede">Each item below is ready for your OK. Approve it and it's done. These are examples of what a Right Hand brings you, not a record of your real business.</p>
            <h3 className="pt-h3" style={{ marginTop: 0 }}>Ready for your OK</h3>

            <div className="pt-card" style={{ padding: "22px 28px 18px" }}>
              {shownLoops.map((l) => (
                <div className="pt-brief" key={l.id}>
                  <div>
                    <span className="pt-tag">{l.tab}</span>
                    <p>{l.brief}</p>
                  </div>
                  <button className="pt-btn pt-ghost pt-small-btn" aria-pressed={approved.includes(l.id)} onClick={() => toggleApproved(l.id)}>
                    {approved.includes(l.id) ? "Approved" : "Approve"}
                  </button>
                </div>
              ))}
              {more > 0 && <p className="pt-note">+ {more} more {more === 1 ? "tab" : "tabs"}, each ready for your OK the same way.</p>}
            </div>

            <h3 className="pt-h3">What we noticed</h3>
            <p className="pt-lede" style={{ marginBottom: 0 }}>{TYPES[type].pattern}</p>

            {q.qualified ? (
              <div className="pt-cta">
                <h3>{QUAL_HEAD}</h3>
                <p>{QUAL_BODY}</p>
                <a className="pt-btn" href={BOOKING_URL}>{CTA_LABEL}</a>
                <p className="pt-sub">Book a Matching Call</p>
              </div>
            ) : null}
            <p className="pt-lede" style={{ margin: "34px 0 14px", color: "#F2F6F4", fontWeight: 600 }}>{smallThings(n3)}</p>
            <ol className="pt-list">
              {shownLoops.map((l) => (
                <li key={l.id}><span>{l.close}</span></li>
              ))}
            </ol>
            {GUIDE_URL && (
              <p className="pt-links" style={{ margin: "18px 0 0" }}>
                Want a full checklist? <a href={GUIDE_URL}>Download the one-page guide (PDF)</a>. Print it. Tick it. Close it.
              </p>
            )}

            {q.qualified && statusEl}
            {!q.qualified && <ThanksSections showGuide={false} />}
            <button className="pt-back" onClick={restart}>Start over</button>
          </div>
        )}
      </div>
      {step === 0 && showBar && (
        <div className="pt-stickycta">
          <button className="pt-btn" onClick={() => setStep(1)}>{START_LABEL}</button>
        </div>
      )}
    </div>
  );
}
