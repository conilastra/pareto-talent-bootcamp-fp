function TabFrame({ ids, shown, sticky, done }: { ids: string[]; shown: number; sticky?: boolean; done?: boolean }) {
  const slow = shown >= 4;
  const spin = (0.9 + shown * 0.18).toFixed(2) + "s";
  const pct = memoryPct(shown);
  const color = shown <= 3 ? "#34D399" : "#E0973F";
  return (
    <div className={"pt-frame" + (sticky ? " pt-sticky" : "")}>
      <div className="pt-strip">
        {ids.length === 0 && (
          <div className="pt-tab pt-ghosttab"><span className="pt-tt">New tab</span></div>
        )}
        {ids.map((id, i) => (
          <div key={id} className={"pt-tab" + (i >= shown ? " pt-out" : "")}>
            <span className={"pt-fav" + (slow ? " pt-spin" : "")} style={slow ? { animationDuration: spin } : undefined} aria-hidden="true" />
            <span className="pt-tt">{LOOP_BY_ID[id].tab}</span>
            <span className="pt-x" aria-hidden="true">×</span>
          </div>
        ))}
      </div>
      <div className="pt-fbody">
        <div aria-live="polite">
          <p className="pt-fcount">{shown === 0 ? "No tabs open" : shown + " " + tabWord(shown) + " open"}</p>
          <p className="pt-fstat">{done && shown === 0 ? "Handled. Waiting for your OK." : tabStatus(shown)}</p>
        </div>
        <div className="pt-mem">
          Brain memory
          <div className="pt-track"><div className={"pt-fill" + (shown >= 8 ? " pt-pulse" : "")} style={{ width: pct + "%", backgroundColor: color }} /></div>
        </div>
      </div>
    </div>
  );
}

